# Copia este archivo como .env.local (o .env.<NODE_ENV>) y completa los valores reales.
# La app carga `.env.${NODE_ENV}` y usa `local` si NODE_ENV no está definido.

# Servidor
PORT=3000

# ============== AUTENTICACIÓN CONTRA PUNTORED ==============
API_USERNAME=usuario_ejemplo
API_PASSWORD=contrasena_ejemplo
API_URL=https://api.example.com/v1
# Nombre y valor del header de API key que se envía en cada petición
API_KEY_NAME=x-api-key
API_KEY_VALUE=clave_ejemplo


# ============== AUTENTICACIÓN CONTRA BASE DE DATOS ==============
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=usuario_ejemplo
DB_PASSWORD=contrasena_ejemplo
DB_DATABASE=nombre_base_ejemplo


# ============== CONFIGURACIÓN JWT ==============
# Mínimo 32 caracteres
JWT_SECRET=secreto_ejemplo_de_al_menos_32_caracteres
# Opcional, por defecto 3600
JWT_EXPIRES_IN_SECONDS=3600


# ============== CREACIÓN DE USUARIOS ==============
# Clave interna enviada en el header x-api-key para crear usuarios.
# Opcional: si no se define, la creación de usuarios queda deshabilitada.
REGISTER_API_KEY=clave_interna_ejemplo


# ============== CONFIGURACIÓN CORS ==============
# Orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:4200,http://localhost:5173
